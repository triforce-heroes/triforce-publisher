{
  "name": "@triforce-heroes/triforce-publisher",
  "version": "4.0.0",
  "description": "Project entries generator for TAPP.",
  "license": "Apache License 2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "bun run lint && bun run test && tsdown",
    "lint": "bun run typecheck && bun run oxlint && bun run oxfmt",
    "lint:fix": "bun run typecheck && bun run oxlint:fix && bun run oxfmt:fix",
    "oxfmt": "oxfmt --check ./src ./tests",
    "oxfmt:fix": "oxfmt --write ./src ./tests",
    "oxlint": "oxlint ./src ./tests",
    "oxlint:fix": "oxlint --fix ./src ./tests",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rheactor/rheactor-query-builder": "github:rheactor/rheactor-query-builder",
    "@triforce-heroes/triforce-core": "github:triforce-heroes/triforce-core",
    "arkregex": "^0.0.8"
  },
  "devDependencies": {
    "@rheactor/rheactor-oxc-config": "github:rheactor/rheactor-oxc-config",
    "@types/node": "^26.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
